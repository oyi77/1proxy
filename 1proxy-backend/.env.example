# 1Proxy Backend Environment Configuration
# Copy this file to .env for local development only. Do not commit real secrets.

# Database Configuration
# For local development: sqlite+aiosqlite:///./data/1proxy.db
# For Railway + Supabase production, set DATABASE_URL in Railway variables:
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/1proxy.db

# Security - Generate a strong secret key (at least 32 characters)
SECRET_KEY=your-super-secret-key-min-32-characters-change-this-in-production

# OAuth Configuration - GitHub
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Configuration - Google
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs Configuration
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_PATH=

# Admin Access - users with collaborator/admin access to this repo get admin role
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=1proxy

# Redis Configuration (for production)
REDIS_URL=redis://localhost:6379
