# 1Proxy Backend Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration
# For development: sqlite+aiosqlite:///./data/1proxy.db
# For production: postgresql+asyncpg://user:password@localhost/1proxy
DATABASE_URL=sqlite+aiosqlite:///./data/1proxy.db

# Security - Generate a strong secret key (at least 32 characters)
SECRET_KEY=your-super-secret-key-min-32-characters-change-this-in-production

# OAuth Configuration - GitHub
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Configuration - Google
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs Configuration
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Redis Configuration (for production)
REDIS_URL=redis://localhost:6379
