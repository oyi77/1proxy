# 1proxy Environment Variables Template

# --- Database ---
# SQLite example: sqlite+aiosqlite:///./data/1proxy.db
# Postgres example: postgresql+asyncpg://user:pass@localhost/1proxy
DATABASE_URL=sqlite+aiosqlite:///./data/1proxy.db

# --- Security ---
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-long-random-string

# --- OAuth (GitHub) ---
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- OAuth (Google) ---
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- URLs ---
# Public URL of your frontend
FRONTEND_URL=http://localhost:3000
# Public URL of your backend API
API_URL=http://localhost:8000

# --- Advanced ---
# Enable Litestream backups for SQLite
LITESTREAM_ENABLED=false
R2_ACCESS_KEY=
R2_SECRET_KEY=
