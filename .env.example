# =============================================================================
# 1proxy — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# The backend reads these on startup via the config/__init__.py module.

# =============================================================================
# Core
# =============================================================================
PORT=8000                          # Backend HTTP port
SECRET_KEY=change-me-to-random-64-char-string
FRONTEND_URL=http://localhost:3000  # Frontend URL (for CORS)
FRONTEND_BASE_PATH=                 # e.g., /app when behind a reverse proxy
VALIDATION_MODE=production          # or "development" for verbose validation
SOURCE_MAX_BYTES=5000000            # Max bytes per scraped source file

# =============================================================================
# Database
# =============================================================================
# Default: SQLite at data/1proxy.db
# For PostgreSQL, use:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/1proxy
DATABASE_URL=sqlite+aiosqlite:///./data/1proxy.db

# =============================================================================
# OAuth
# =============================================================================
# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Hunter / Scraping
# =============================================================================
# GitHub token for the GitHubStrategy hunter (higher rate limits)
GITHUB_TOKEN=

# =============================================================================
# Railway (optional — only needed for Railway deployment)
# =============================================================================
RAILWAY_PUBLIC_DOMAIN=
