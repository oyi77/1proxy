# 1proxy Environment Variables Template
# Copy to .env for local development only. Do not commit real secrets.

# --- Database ---
# Local SQLite example: sqlite+aiosqlite:///./data/1proxy.db
# Supabase/Railway production example:
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/1proxy.db

# --- Security ---
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-long-random-string

# --- OAuth (GitHub) ---
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- OAuth (Google) ---
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Admin Access Control ---
# GitHub repository for admin access control
# Only users with admin/collaborator access to this repo get admin role
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=1proxy

# --- URLs ---
# Public URL of your frontend. Production: https://oyi77.is-a.dev/1proxy
FRONTEND_URL=http://localhost:3000
# Frontend subpath when hosted on GitHub Pages/custom domain.
FRONTEND_BASE_PATH=
# Public URL of your backend API
API_URL=http://localhost:8000
